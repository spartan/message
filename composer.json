{
    "name": "spartan/message",
    "description": "Spartan Message library",
    "type": "library",
    "keywords": [
        "library",
        "spartan",
        "message"
    ],
    "homepage": "https://spartanphp.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Iulian N.",
            "email": "iulian@spartanphp.com",
            "homepage": "https://spartanphp.com",
            "role": "developer"
        }
    ],
    "support": {
        "email": "support@spartanphp.com",
        "docs": "https://docs.spartanphp.com"
    },
    "require": {
        "php": ">=7.4",
        "ext-fileinfo": "*",
        "spartan/http": "^0.1.0",
        "laminas/laminas-mail": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "Spartan\\Message\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "spartan/service": "^0.1.0",
        "symfony/mailer": "^6.4|^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Spartan\\Message\\Test\\": "tests/"
        }
    },
    "suggest": {
        "symfony/mailer": "symfony/mailer:^6.4|^7.0 for SMTP providers (Smtp, Mailtrap)"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "spartan": {
            "install": {
                "env": {
                    "MESSAGE_ADAPTER": "mailtrap"
                },
                "copy": {
                    "config/message.php": "config/message.php"
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
